{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_seq": {
      "default": 0,
      "description": "Return events with `seq` greater than this (0 = from the start).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "execution_id": {
      "type": "string"
    },
    "limit": {
      "default": null,
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "wait_ms": {
      "default": 0,
      "description": "Wait up to this long for new events (capped at [`MAX_EVENT_WAIT_MS`]).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "execution_id"
  ],
  "title": "EventsParams",
  "type": "object"
}
