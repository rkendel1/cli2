{
  "$defs": {
    "Check": {
      "description": "A deterministic check evaluated by runtime code after execution.",
      "oneOf": [
        {
          "description": "The process exit status equals `expected`. This is process-level evidence\nonly: it never by itself establishes task-level success.",
          "properties": {
            "expected": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "process_exit_status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "expected"
          ],
          "type": "object"
        },
        {
          "description": "A file exists after execution (optionally modified after the step started).",
          "properties": {
            "modified_after_start": {
              "default": false,
              "type": "boolean"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "const": "file_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "A file or directory exists after execution.",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "path_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Captured standard output contains the given text.",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "stdout_contains",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "After a file edit, the file read back from disk has exactly this\ncontent hash. It shows the edit landed as planned; it says nothing about\nwhether the change achieves anything.",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "type": {
              "const": "file_sha256",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "sha256"
          ],
          "type": "object"
        }
      ]
    },
    "Constraints": {
      "additionalProperties": false,
      "description": "Explicit constraints. Unspecified constraints are recorded as absent and are\nnever interpreted as permission.",
      "properties": {
        "modify_files": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkConstraint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "NetworkConstraint": {
      "oneOf": [
        {
          "const": "allow",
          "description": "Network access is permitted.",
          "type": "string"
        },
        {
          "const": "deny",
          "description": "Network access is forbidden; plans that may use the network are rejected.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "No statement either way. Not interpreted as permission.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "capture_help": {
      "default": false,
      "description": "Consent to run `--help` of the best unknown-interface match (bounded).",
      "type": "boolean"
    },
    "constraints": {
      "$ref": "#/$defs/Constraints",
      "default": {}
    },
    "expectations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    },
    "idempotency_key": {
      "description": "Retrying with the same key (and same inputs) returns the same plan.",
      "type": [
        "string",
        "null"
      ]
    },
    "intent": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "resolver": {
      "description": "`deterministic` (default), `apple-fm` or `auto`.",
      "type": [
        "string",
        "null"
      ]
    },
    "selection": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeout_secs": {
      "description": "Bound each process of the plan to this many seconds (1–3600).",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "project",
    "intent"
  ],
  "title": "PlanParams",
  "type": "object"
}
