    },
    "current_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "goal": {
      "type": "string"
    },
    "investigation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Investigation"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_seq": {
      "format": "int64",
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "paused": {
      "type": "boolean"
    },
    "project": {
      "type": "string"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TaskState"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepView"
      },
      "type": "array"
    },
    "steps_used": {
      "description": "Steps taken so far, and failed attempts counted against the limit.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "strategy": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "unresolved": {
      "description": "What is still open, in words.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "project",
    "state",
    "paused",
    "strategy",
    "created_at",
    "updated_at",
    "limits",
    "steps_used",
    "attempts",
    "criteria",
    "steps",
    "unresolved",
    "last_seq"
  ],
  "title": "TaskView",
  "type": "object"
}
